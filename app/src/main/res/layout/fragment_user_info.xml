<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_arrow_back"
            android:layout_marginTop="12dp"
            app:tint="@android:color/holo_orange_dark"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvTitleUser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Новий клієнт"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvSubtitleUser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Заповніть, будь ласка, свої дані."
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitleUser"
            app:layout_constraintStart_toStartOf="@id/tvTitleUser"
            app:layout_constraintEnd_toEndOf="@id/tvTitleUser" />

        <!-- Номер телефону -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPhone"
            style="@style/OrangeOutlinedInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Номер телефону"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitleUser"
            app:layout_constraintStart_toStartOf="@id/tvSubtitleUser"
            app:layout_constraintEnd_toEndOf="@id/tvSubtitleUser">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPhone"
                android:inputType="phone"
                android:maxLines="1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+380"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Ім’я -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilFirstName"
            style="@style/OrangeOutlinedInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:hint="Ім'я"
            app:layout_constraintTop_toBottomOf="@id/tilPhone"
            app:layout_constraintStart_toStartOf="@id/tilPhone"
            app:layout_constraintEnd_toEndOf="@id/tilPhone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFirstName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Прізвище -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLastName"
            style="@style/OrangeOutlinedInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Прізвище"
            app:layout_constraintTop_toBottomOf="@id/tilFirstName"
            app:layout_constraintStart_toStartOf="@id/tilFirstName"
            app:layout_constraintEnd_toEndOf="@id/tilFirstName">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLastName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Стать -->
        <TextView
            android:id="@+id/tvGender"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Стать"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tilLastName"
            app:layout_constraintStart_toStartOf="@id/tilLastName"
            app:layout_constraintEnd_toEndOf="@id/tilLastName" />

        <RadioGroup
            android:id="@+id/rgGender"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvGender"
            app:layout_constraintStart_toStartOf="@id/tvGender"
            app:layout_constraintEnd_toEndOf="@id/tvGender">

            <RadioButton
                android:id="@+id/rbFemale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Жіноча" />

            <RadioButton
                android:id="@+id/rbMale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Чоловіча"
                android:layout_marginStart="16dp" />
        </RadioGroup>

        <!-- Дата народження -->
        <TextView
            android:id="@+id/tvBirthDateLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Дата народження"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/rgGender"
            app:layout_constraintStart_toStartOf="@id/rgGender"
            app:layout_constraintEnd_toEndOf="@id/rgGender" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Оберіть дату"
            android:layout_marginTop="8dp"
            app:backgroundTint="@color/orange"
            app:layout_constraintTop_toBottomOf="@id/tvBirthDateLabel"
            app:layout_constraintStart_toStartOf="@id/tvBirthDateLabel"
            app:layout_constraintEnd_toEndOf="@id/tvBirthDateLabel" />

        <!-- Кнопка Продовжити -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveAndContinue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Продовжити"
            android:layout_marginTop="24dp"
            app:backgroundTint="@color/orange"
            app:layout_constraintTop_toBottomOf="@id/btnSelectDate"
            app:layout_constraintStart_toStartOf="@id/btnSelectDate"
            app:layout_constraintEnd_toEndOf="@id/btnSelectDate"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Прогресбар -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/btnSaveAndContinue"
            app:layout_constraintStart_toStartOf="@id/btnSaveAndContinue"
            app:layout_constraintEnd_toEndOf="@id/btnSaveAndContinue" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>